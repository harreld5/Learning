rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each family's data lives under its private family code (20+ random characters).
    // Phones sign in anonymously (no accounts). Nobody can list families, only open one by its code.
    match /families/{family}/{collection}/{doc} {
      allow read, write: if request.auth != null && family.size() >= 20;
    }
  }
}
